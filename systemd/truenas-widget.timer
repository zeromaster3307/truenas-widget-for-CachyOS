# systemd-User-Timer: startet den Prüfer regelmässig.
# @INTERVAL@ wird von install.sh aus der Konfiguration (interval_minutes) gesetzt.
[Unit]
Description=TrueNAS-Status regelmässig prüfen

[Timer]
# 1 Minute nach dem Start des Timers (beim Anmelden bzw. nach install.sh) das erste Mal ...
OnActiveSec=1min
# ... danach im eingestellten Abstand
OnUnitActiveSec=@INTERVAL@min
AccuracySec=30s

[Install]
WantedBy=timers.target

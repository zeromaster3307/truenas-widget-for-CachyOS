# systemd-User-Timer: startet den Prüfer regelmässig.
# @ONCALENDAR@ setzt install.sh aus der Konfiguration (interval_minutes),
# z. B. "*-*-* *:00/15:00" = jede Viertelstunde (xx:00, xx:15, xx:30, xx:45).
[Unit]
Description=TrueNAS-Status regelmässig prüfen

[Timer]
OnCalendar=@ONCALENDAR@
# Verpasste Prüfungen (PC war aus) beim Start sofort nachholen.
# Wirkt laut systemd.timer(5) NUR zusammen mit OnCalendar=.
Persistent=true
AccuracySec=30s

[Install]
WantedBy=timers.target
